<%
  const colors = { announcement: ["#4f46e5", "#7c3aed", "📣"], promo: ["#db2777", "#f59e0b", "🎁"], results: ["#059669", "#0ea5e9", "🏆"] };
  const c = colors[variant] || colors.announcement;
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= heading %></title>
  </head>
  <body style="margin:0;background:#f0f4f8;font-family:'Segoe UI',Tahoma,Verdana,sans-serif;color:#1a1a2e;">
    <div style="padding:40px 16px;">
      <div style="max-width:560px;margin:0 auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <div style="background:linear-gradient(135deg,<%= c[0] %>,<%= c[1] %>);padding:32px 40px;text-align:center;color:#fff;">
          <div style="font-size:34px;"><%= c[2] %></div>
          <div style="font-size:22px;font-weight:800;margin-top:6px;"><%= appName %></div>
        </div>
        <div style="padding:36px 40px;">
          <h1 style="font-size:22px;margin:0 0 14px;"><%= heading %></h1>
          <div style="font-size:15px;line-height:1.7;color:#4b5563;white-space:pre-line;"><%= message %></div>
          <% if (ctaLabel && ctaUrl) { %>
            <div style="margin-top:28px;text-align:center;">
              <a href="<%= ctaUrl %>" style="display:inline-block;background:<%= c[0] %>;color:#fff;text-decoration:none;font-weight:700;padding:13px 28px;border-radius:12px;"><%= ctaLabel %></a>
            </div>
          <% } %>
        </div>
        <div style="background:#f9fafb;border-top:1px solid #e5e7eb;padding:22px 40px;text-align:center;font-size:12.5px;color:#9ca3af;line-height:1.7;">
          Questions? <a href="mailto:<%= supportEmail %>" style="color:<%= c[0] %>;text-decoration:none;"><%= supportEmail %></a><br />
          &copy; <%= year %> <%= appName %>. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>

<%
  // variant → [accent, accent-lip, soft bg, emoji, kicker]
  const palette = {
    announcement: ["#8b5cf6", "#5f36c4", "#ede5ff", "📣", "Big news"],
    promo:        ["#ff6b57", "#c9442f", "#ffe5e0", "🎁", "Special treat"],
    results:      ["#22a559", "#167a40", "#dff5e6", "🏆", "Results are in"]
  };
  const c = palette[variant] || palette.announcement;
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light only" />
    <title><%= heading %></title>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      body { margin:0; padding:0; background:#fff8e7; }
      .d { font-family:'Baloo 2','Nunito','Trebuchet MS',Verdana,sans-serif; }
      .b { font-family:'Nunito','Trebuchet MS',Verdana,sans-serif; }
      a { color:inherit; }
      @media only screen and (max-width:520px) {
        .w { width:100% !important; }
        .px { padding-left:20px !important; padding-right:20px !important; }
        .dg { width:40px !important; height:54px !important; font-size:28px !important; line-height:54px !important; }
        .h1 { font-size:26px !important; }
      }
    </style>
  </head>
  <body class="b" style="margin:0;padding:0;background:#fff8e7;color:#1e2a4a;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#fff8e7;"><%= heading %></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fff8e7;">
      <tr><td align="center" style="padding:32px 12px;">
        <table role="presentation" class="w" width="580" cellpadding="0" cellspacing="0" border="0" style="width:580px;max-width:580px;">
          <!-- brand row -->
          <tr><td align="center" style="padding:0 0 18px;">
            <span class="d" style="font-size:24px;font-weight:800;color:#1e2a4a;letter-spacing:-0.3px;">Guru <span style="background:#ffc736;color:#1e2a4a;border-radius:8px;padding:0 8px;border-bottom:3px solid #d99f00;">EduTech</span></span>
          </td></tr>
          <!-- card -->
          <tr><td style="background:#ffffff;border:2px solid #e8dfc6;border-bottom:6px solid #d6caa6;border-radius:26px;overflow:hidden;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr><td style="border-radius:24px 24px 0 0;overflow:hidden;"><table role="presentation" width="100%%" cellpadding="0" cellspacing="0" border="0"><tr>
  <td height="8" width="16%%" style="background:#22a559;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="16%%" style="background:#ffc736;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#ff6b57;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#8b5cf6;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#3b82f6;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#22a559;font-size:0;line-height:0;">&nbsp;</td>
</tr></table></td></tr>
              <!-- chalkboard hero -->
              <tr><td align="center" class="px" style="background:#17463a;padding:34px 36px 30px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tr>
                  <td align="center" valign="middle" style="width:72px;height:72px;background:#ffc736;border-radius:22px;border-bottom:6px solid #d99f00;font-size:36px;line-height:72px;transform:rotate(-6deg);"><%= c[3] %></td>
                </tr></table>
                <div class="d" style="margin-top:16px;font-size:12px;font-weight:800;letter-spacing:2.4px;text-transform:uppercase;color:#bfd9ce;"><%= c[4] %></div>
                <h1 class="d h1" style="margin:12px 0 0;font-size:30px;line-height:1.15;font-weight:800;color:#fff8e7;letter-spacing:-0.4px;"><%= heading %></h1>
              </td></tr>
              <tr><td class="px" style="padding:30px 36px 30px;">
                <div style="font-size:16px;line-height:1.75;color:#3d4868;"><%- message %></div>
                <% if (ctaLabel && ctaUrl) { %>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:30px auto 6px;"><tr>
                  <td align="center" style="background:<%= c[0] %>;border-bottom:5px solid <%= c[1] %>;border-radius:16px;">
                    <a class="d" href="<%= ctaUrl %>" style="display:inline-block;padding:14px 34px;font-size:17px;font-weight:800;color:#ffffff;text-decoration:none;letter-spacing:0.2px;"><%= ctaLabel %> &rarr;</a>
                  </td>
                </tr></table>
                <% } %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;"><tr>
                  <td style="background:<%= c[2] %>;border-radius:16px;padding:14px 16px;font-size:13.5px;line-height:1.6;color:#1e2a4a;">🎯 <strong>Keep the streak going</strong> &ndash; a few minutes of quizzing a day adds up fast.</td>
                </tr></table>
          </td></tr>
            </table>
          </td></tr>
          <!-- footer -->
          <tr><td align="center" class="px" style="padding:22px 24px 6px;font-size:12.5px;line-height:1.7;color:#5a6685;">
            Need a hand? Say hi at <a href="mailto:<%= supportEmail %>" style="color:#167a40;font-weight:800;text-decoration:none;"><%= supportEmail %></a><br />
            You are receiving this message from the <%= appName %> team.
          </td></tr>
          <tr><td align="center" style="padding:4px 24px 0;font-size:12px;color:#9aa3b8;">
            &copy; <%= year %> <%= appName %> &middot; Learn. Play. Win. 🏆
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>

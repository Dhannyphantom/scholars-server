<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light only" />
    <title>Reset your password – <%= appName %></title>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      body { margin:0; padding:0; background:#fff8e7; }
      .d { font-family:'Baloo 2','Nunito','Trebuchet MS',Verdana,sans-serif; }
      .b { font-family:'Nunito','Trebuchet MS',Verdana,sans-serif; }
      a { color:inherit; }
      @media only screen and (max-width:520px) {
        .w { width:100% !important; }
        .px { padding-left:20px !important; padding-right:20px !important; }
        .dg { width:40px !important; height:54px !important; font-size:28px !important; line-height:54px !important; }
        .h1 { font-size:26px !important; }
      }
    </style>
  </head>
  <body class="b" style="margin:0;padding:0;background:#fff8e7;color:#1e2a4a;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#fff8e7;">Use this code to reset your Guru password – expires in <%= expiryMinutes %> minutes.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fff8e7;">
      <tr><td align="center" style="padding:32px 12px;">
        <table role="presentation" class="w" width="580" cellpadding="0" cellspacing="0" border="0" style="width:580px;max-width:580px;">
          <!-- brand row -->
          <tr><td align="center" style="padding:0 0 18px;">
            <span class="d" style="font-size:24px;font-weight:800;color:#1e2a4a;letter-spacing:-0.3px;">Guru <span style="background:#ffc736;color:#1e2a4a;border-radius:8px;padding:0 8px;border-bottom:3px solid #d99f00;">EduTech</span></span>
          </td></tr>
          <!-- card -->
          <tr><td style="background:#ffffff;border:2px solid #e8dfc6;border-bottom:6px solid #d6caa6;border-radius:26px;overflow:hidden;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr><td style="border-radius:24px 24px 0 0;overflow:hidden;"><table role="presentation" width="100%%" cellpadding="0" cellspacing="0" border="0"><tr>
  <td height="8" width="16%%" style="background:#22a559;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="16%%" style="background:#ffc736;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#ff6b57;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#8b5cf6;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#3b82f6;font-size:0;line-height:0;">&nbsp;</td>
  <td height="8" width="17%%" style="background:#22a559;font-size:0;line-height:0;">&nbsp;</td>
</tr></table></td></tr>
              <!-- chalkboard hero -->
              <tr><td align="center" class="px" style="background:#17463a;padding:34px 36px 30px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tr>
                  <td align="center" valign="middle" style="width:72px;height:72px;background:#ffc736;border-radius:22px;border-bottom:6px solid #d99f00;font-size:36px;line-height:72px;transform:rotate(-6deg);">🔑</td>
                </tr></table>
                <div class="d" style="margin-top:16px;font-size:12px;font-weight:800;letter-spacing:2.4px;text-transform:uppercase;color:#bfd9ce;">Password reset</div>
                <h1 class="d h1" style="margin:12px 0 0;font-size:30px;line-height:1.15;font-weight:800;color:#fff8e7;letter-spacing:-0.4px;">Forgot your password, <%= userName %>? 🙈</h1>
              </td></tr>
              <tr><td class="px" style="padding:30px 36px 30px;">
                <p style="margin:0;font-size:15.5px;line-height:1.7;color:#5a6685;">Happens to the best of us. Use the code below in <strong style="color:#1e2a4a;"><%= appName %></strong> to pick a brand-new password and get back to the leaderboard.</p>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:26px 0 8px;background:#fff3c4;border:2px dashed #d99f00;border-radius:20px;">
              <tr><td align="center" style="padding:20px 10px 22px;">
                <div class="d" style="font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#6b5200;margin-bottom:12px;">Your reset code</div>
                <table role="presentation" cellpadding="0" cellspacing="6" border="0" align="center"><tr>
                  <% String(otp).split('').forEach(function (d, i) {
                       var pal = [['#22a559','#167a40'],['#8b5cf6','#5f36c4'],['#ff6b57','#c9442f'],['#3b82f6','#2358c4'],['#22a559','#167a40'],['#8b5cf6','#5f36c4']][i % 6]; %>
                  <td class="dg d" align="center" style="width:46px;height:60px;background:#ffffff;border:2px solid #e8dfc6;border-bottom:5px solid <%= pal[0] %>;border-radius:14px;font-size:32px;font-weight:800;line-height:60px;color:<%= pal[1] %>;"><%= d %></td>
                  <% }); %>
                </tr></table>
                <div style="margin-top:14px;font-size:13px;color:#6b5200;">⏱️ Expires in <strong><%= expiryMinutes %> minutes</strong> &middot; single use</div>
              </td></tr>
            </table>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;"><tr>
  <td style="background:#ffe5e0;border:2px solid #ffbeb3;border-radius:16px;padding:14px 16px;font-size:14px;line-height:1.6;color:#c9442f;"><span style="font-size:18px;">🚨</span>&nbsp; <strong>Didn&rsquo;t ask for this?</strong> Ignore this email – your password stays exactly as it is. If it keeps happening, tell us right away.</td>
</tr></table>
                <div class="d" style="margin:28px 0 14px;font-size:18px;font-weight:800;color:#1e2a4a;">Get back in 🚀</div>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
  <td valign="top" width="40" style="padding:0 0 12px;"><div class="d" style="width:30px;height:30px;line-height:30px;text-align:center;background:#22a559;border-bottom:3px solid #167a40;border-radius:10px;color:#fff;font-weight:800;font-size:15px;">1</div></td>
  <td valign="top" style="padding:3px 0 12px;font-size:14.5px;line-height:1.55;color:#1e2a4a;">Open the <strong><%= appName %></strong> app and tap <strong>Forgot password</strong>.</td>
</tr><tr>
  <td valign="top" width="40" style="padding:0 0 12px;"><div class="d" style="width:30px;height:30px;line-height:30px;text-align:center;background:#8b5cf6;border-bottom:3px solid #5f36c4;border-radius:10px;color:#fff;font-weight:800;font-size:15px;">2</div></td>
  <td valign="top" style="padding:3px 0 12px;font-size:14.5px;line-height:1.55;color:#1e2a4a;">Enter the 6-digit code above.</td>
</tr><tr>
  <td valign="top" width="40" style="padding:0 0 12px;"><div class="d" style="width:30px;height:30px;line-height:30px;text-align:center;background:#ff6b57;border-bottom:3px solid #c9442f;border-radius:10px;color:#fff;font-weight:800;font-size:15px;">3</div></td>
  <td valign="top" style="padding:3px 0 12px;font-size:14.5px;line-height:1.55;color:#1e2a4a;">Choose a strong new password &ndash; make it a good one!</td>
</tr></table>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;"><tr>
  <td style="background:#e1edff;border:2px solid #b5d0fa;border-radius:16px;padding:14px 16px;font-size:14px;line-height:1.6;color:#2358c4;"><span style="font-size:18px;">💡</span>&nbsp; Pro tip: use a passphrase only you would know, and never reuse it elsewhere.</td>
</tr></table>
          </td></tr>
            </table>
          </td></tr>
          <!-- footer -->
          <tr><td align="center" class="px" style="padding:22px 24px 6px;font-size:12.5px;line-height:1.7;color:#5a6685;">
            Need a hand? Say hi at <a href="mailto:<%= supportEmail %>" style="color:#167a40;font-weight:800;text-decoration:none;"><%= supportEmail %></a><br />
            You received this because a password reset was requested for your account.
          </td></tr>
          <tr><td align="center" style="padding:4px 24px 0;font-size:12px;color:#9aa3b8;">
            &copy; <%= year %> <%= appName %> &middot; Learn. Play. Win. 🏆
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
